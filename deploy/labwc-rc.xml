<?xml version="1.0"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <touch deviceName="10-0038 generic ft5x06 (79)" mapToOutput="DSI-1" mouseEmulation="yes"/>
  <!-- Atalhos padrão do Raspberry Pi OS (copiados de /etc/xdg/labwc/rc.xml) + F11 -->
  <keyboard>
    <numlock>off</numlock>
    <default />
    <keybind key="C-A-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="C-A-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="C-A-Up">
      <action name="Maximize" />
    </keybind>
    <keybind key="C-A-Down">
      <action name="UnMaximize" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wfpanelctl volumepulse volu" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wfpanelctl volumepulse vold" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wfpanelctl volumepulse mute" />
    </keybind>
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="wfpanelctl ?menu menu" />
    </keybind>
    <keybind key="C-A-w">
      <action name="Execute" command="wfpanelctl netman menu" />
    </keybind>
    <keybind key="C-A-b">
      <action name="Execute" command="wfpanelctl bluetooth menu" />
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="lab-sensible-terminal" />
    </keybind>
    <keybind key="C-A-space">
      <action name="Execute" command="gui-pkinst orca reboot" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Execute" command="pishutdown" />
    </keybind>
    <keybind key="XF86PowerOff" onRelease="yes">
      <action name="Execute" command="pwrkey" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="gui-screenshot" />
    </keybind>
    <keybind key="C-Print">
      <action name="Execute" command="gui-screenshot -a" />
    </keybind>
    <keybind key="C-A-m">
      <action name="ToggleMagnify" />
    </keybind>
    <keybind key="C-A-l">
      <action name="Execute" command="swaylock -p" />
    </keybind>
    <keybind key="A-F2">
      <action name="Execute" command="gui-runcmd" />
    </keybind>
    <!-- F11: alterna tela cheia / janela na janela selecionada -->
    <keybind key="F11">
      <action name="ToggleFullscreen" />
    </keybind>
  </keyboard>
  <windowRules>
    <!-- Central de controle do Tello: tela cheia na tela touch -->
    <windowRule title="Tello - Painel Vertical">
      <action name="MoveToOutput" output="DSI-1"/>
      <action name="ToggleFullscreen"/>
    </windowRule>
    <!-- Câmera do Tello: monitor HDMI (a tela cheia é pedida pelo próprio OpenCV) -->
    <windowRule title="Tello - Deteccao de Fachada*">
      <action name="MoveToOutput" output="HDMI-A-1"/>
    </windowRule>
  </windowRules>
</openbox_config>
